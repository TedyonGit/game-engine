  COMMAND = cd /home/tedy/Desktop/projects/game-engine/Sandbox && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build Sandbox/install/local: phony Sandbox/CMakeFiles/install/local.util


